{
  "name": "pi-code-gui-dev",
  "publisher": "lazybone404",
  "author": "lazybone404",
  "displayName": "Pi Code Gui Dev",
  "description": "Pi coding agent GUI in VS Code (Chinese UI support)",
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lazybone404/pi-code-gui-dev"
  },
  "type": "module",
  "engines": {
    "vscode": "^1.118.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "pi-code-gui.codeAgent",
        "title": "%command.codeAgent%",
        "icon": "$(hubot)"
      },
      {
        "command": "pi-code-gui.abort",
        "title": "%command.abort%"
      },
      {
        "command": "pi-code-gui.installPi",
        "title": "%command.installPi%"
      },
      {
        "command": "pi-code-gui.pickModel",
        "title": "%command.switchModel%"
      },
      {
        "command": "pi-code-gui.cycleModel",
        "title": "%command.cycleModel%"
      },
      {
        "command": "pi-code-gui.pickThinkingLevel",
        "title": "%command.setThinkingLevel%"
      },
      {
        "command": "pi-code-gui.cycleThinkingLevel",
        "title": "%command.cycleThinkingLevel%"
      },
      {
        "command": "pi-code-gui.pickFile",
        "title": "%command.pickFile%"
      },
      {
        "command": "pi-code-gui.pickCommand",
        "title": "%command.pickCommand%"
      },
      {
        "command": "pi-code-gui.pickFork",
        "title": "%command.forkSession%"
      },
      {
        "command": "pi-code-gui.exportSession",
        "title": "%command.exportSession%"
      },
      {
        "command": "pi-code-gui.cloneSession",
        "title": "%command.cloneSession%"
      },
      {
        "command": "pi-code-gui.login",
        "title": "%command.login%"
      },
      {
        "command": "pi-code-gui.resumeSession",
        "title": "%command.resumeSession%"
      },
      {
        "command": "pi-code-gui.compact",
        "title": "%command.compact%"
      },
      {
        "command": "pi-code-gui.toggleAutoCompaction",
        "title": "%command.toggleAutoCompaction%"
      },
      {
        "command": "pi-code-gui.toggleAutoRetry",
        "title": "%command.toggleAutoRetry%"
      },
      {
        "command": "pi-code-gui.addSession",
        "title": "%command.addSession%",
        "icon": {
          "light": "media/pi-editor-button.svg",
          "dark": "media/pi-editor-dark.svg"
        }
      },
      {
        "command": "pi-code-gui.revealEntry",
        "title": "%command.revealEntry%"
      },
      {
        "command": "pi-code-gui.copyEntryText",
        "title": "%command.copyEntryText%"
      },
      {
        "command": "pi-code-gui.focusSession",
        "title": "%command.focusSession%"
      },
      {
        "command": "pi-code-gui.pickSessionModel",
        "title": "%command.pickSessionModel%"
      },
      {
        "command": "pi-code-gui.pickSessionThinking",
        "title": "%command.pickSessionThinking%"
      },
      {
        "command": "pi-code-gui.reloadContext",
        "title": "%command.reloadContext%"
      },
      {
        "command": "pi-code-gui.forkSession",
        "title": "%command.forkSession%"
      },
      {
        "command": "pi-code-gui.resumePastSession",
        "title": "%command.resumePastSession%"
      },
      {
        "command": "pi-code-gui.deletePastSession",
        "title": "%command.deletePastSession%"
      },
      {
        "command": "pi-code-gui.deleteAllPastSessions",
        "title": "%command.deleteAllPastSessions%",
        "icon": "$(trash)"
      },
      {
        "command": "pi-code-gui.filterPastSessions",
        "title": "%command.filterPastSessions%",
        "icon": "$(filter)"
      },
      {
        "command": "pi-code-gui.installPackage",
        "title": "%command.installPackage%"
      },
      {
        "command": "pi-code-gui.uninstallPackage",
        "title": "%command.uninstallPackage%"
      },
      {
        "command": "pi-code-gui.searchPackages",
        "title": "%command.searchPackages%",
        "icon": "$(search)"
      },
      {
        "command": "pi-code-gui.refreshPackages",
        "title": "%command.refreshPackages%",
        "icon": "$(refresh)"
      },
      {
        "command": "pi-code-gui.updatePackage",
        "title": "%command.updatePackage%"
      },
      {
        "command": "pi-code-gui.updateAllPackages",
        "title": "%command.updateAllPackages%",
        "icon": "$(sync)"
      },
      {
        "command": "pi-code-gui.openPiDevMarketplace",
        "title": "%command.openDevMarketplace%"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pi-code-gui",
          "title": "%viewContainer.title%",
          "icon": "media/pi-activity.svg"
        }
      ]
    },
    "views": {
      "pi-code-gui": [
        {
          "type": "webview",
          "id": "pi-code-gui.chat",
          "name": "Chat"
        },
        {
          "type": "tree",
          "id": "pi-code-gui.sessions",
          "name": "%view.sessions%",
          "icon": "multiple-windows",
          "when": "pi-code-gui.showSessionTree"
        },
        {
          "type": "tree",
          "id": "pi-code-gui.packages",
          "name": "%view.packages%",
          "icon": "package",
          "when": "pi-code-gui.showPackageTree"
        }
      ]
    },
    "keybindings": [
      {
        "command": "pi-code-gui.codeAgent",
        "key": "ctrl+alt+i",
        "mac": "cmd+alt+i"
      },
      {
        "command": "pi-code-gui.pickModel",
        "key": "ctrl+l",
        "mac": "cmd+l"
      },
      {
        "command": "pi-code-gui.cycleModel",
        "key": "ctrl+p",
        "mac": "cmd+p"
      },
      {
        "command": "pi-code-gui.pickThinkingLevel",
        "key": "ctrl+shift+tab",
        "mac": "cmd+shift+tab"
      },
      {
        "command": "pi-code-gui.pickFile",
        "key": "ctrl+shift+@",
        "mac": "cmd+shift+@"
      },
      {
        "command": "pi-code-gui.pickCommand",
        "key": "ctrl+/",
        "mac": "cmd+/"
      }
    ],
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "pi-code-gui.showSessionTree": {
          "type": "boolean",
          "default": false,
          "description": "Show the Past Sessions tree view in the sidebar. Sessions are managed via the chat tab bar by default."
        },
        "pi-code-gui.showPackageTree": {
          "type": "boolean",
          "default": false,
          "description": "Show the Packages tree view in the sidebar."
        },
        "pi-code-gui.promptToInstall": {
          "type": "boolean",
          "default": true,
          "description": "%config.promptToInstall%"
        },
        "pi-code-gui.anthropicApiKey": {
          "type": "string",
          "default": "",
          "description": "%config.anthropicApiKey%"
        },
        "pi-code-gui.openaiApiKey": {
          "type": "string",
          "default": "",
          "description": "%config.openaiApiKey%"
        },
        "pi-code-gui.systemPromptAppend": {
          "type": "string",
          "default": "",
          "description": "%config.systemPromptAppend%"
        },
        "pi-code-gui.enableSkills": {
          "type": "boolean",
          "default": true,
          "description": "%config.enableSkills%"
        },
        "pi-code-gui.enableContextFiles": {
          "type": "boolean",
          "default": true,
          "description": "%config.enableContextFiles%"
        },
        "pi-code-gui.enablePromptTemplates": {
          "type": "boolean",
          "default": true,
          "description": "%config.enablePromptTemplates%"
        },
        "pi-code-gui.defaultModelProvider": {
          "type": "string",
          "default": "",
          "description": "%config.defaultModelProvider%"
        },
        "pi-code-gui.defaultModelId": {
          "type": "string",
          "default": "",
          "description": "%config.defaultModelId%"
        },
        "pi-code-gui.defaultThinkingLevel": {
          "type": "string",
          "default": "off",
          "enum": [
            "off",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh"
          ],
          "description": "%config.defaultThinkingLevel%"
        },
        "pi-code-gui.contextBudget": {
          "type": "number",
          "default": 0,
          "description": "%config.contextBudget%"
        },
        "pi-code-gui.sessionDir": {
          "type": "string",
          "default": "",
          "description": "%config.sessionDir%"
        },
        "pi-code-gui.autoOpenOnStart": {
          "type": "boolean",
          "default": true,
          "description": "%config.autoOpenOnStart%"
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "pi-code-gui.addSession",
          "group": "navigation",
          "when": "resourceScheme != pi"
        }
      ],
      "view/item/context": [
        {
          "command": "pi-code-gui.revealEntry",
          "when": "view == pi-code-gui.sessions && viewItem =~ /^sessionEntry/",
          "group": "navigation"
        },
        {
          "command": "pi-code-gui.copyEntryText",
          "when": "view == pi-code-gui.sessions && viewItem =~ /^sessionEntry/",
          "group": "1_copy"
        },
        {
          "command": "pi-code-gui.forkSession",
          "when": "view == pi-code-gui.sessions && viewItem =~ /^sessionEntry-(user|assistant|custom)$/",
          "group": "2_actions"
        },
        {
          "command": "pi-code-gui.forkSession",
          "when": "view == pi-code-gui.sessions && viewItem == pastSessionEntry",
          "group": "2_actions"
        },
        {
          "command": "pi-code-gui.compact",
          "when": "view == pi-code-gui.sessions && viewItem == session",
          "group": "3_sessionActions"
        },
        {
          "command": "pi-code-gui.cloneSession",
          "when": "view == pi-code-gui.sessions && viewItem == session",
          "group": "3_sessionActions"
        },
        {
          "command": "pi-code-gui.exportSession",
          "when": "view == pi-code-gui.sessions && viewItem == session",
          "group": "3_sessionActions"
        },
        {
          "command": "pi-code-gui.reloadContext",
          "when": "view == pi-code-gui.sessions && viewItem == session",
          "group": "3_sessionActions"
        },
        {
          "command": "pi-code-gui.resumePastSession",
          "when": "view == pi-code-gui.sessions && viewItem == pastSessionEntry",
          "group": "navigation"
        },
        {
          "command": "pi-code-gui.deletePastSession",
          "when": "view == pi-code-gui.sessions && viewItem == pastSessionEntry",
          "group": "2_actions"
        },
        {
          "command": "pi-code-gui.installPackage",
          "when": "view == pi-code-gui.packages && viewItem == package-marketplace",
          "group": "navigation"
        },
        {
          "command": "pi-code-gui.uninstallPackage",
          "when": "view == pi-code-gui.packages && viewItem == package-installed",
          "group": "navigation"
        },
        {
          "command": "pi-code-gui.updatePackage",
          "when": "view == pi-code-gui.packages && viewItem == package-installed",
          "group": "1_update"
        }
      ],
      "view/title": [
        {
          "command": "pi-code-gui.addSession",
          "when": "view == pi-code-gui.sessions",
          "group": "navigation"
        },
        {
          "command": "pi-code-gui.filterPastSessions",
          "when": "view == pi-code-gui.sessions",
          "group": "navigation"
        },
        {
          "command": "pi-code-gui.deleteAllPastSessions",
          "when": "view == pi-code-gui.sessions",
          "group": "navigation"
        },
        {
          "command": "pi-code-gui.searchPackages",
          "when": "view == pi-code-gui.packages",
          "group": "navigation"
        },
        {
          "command": "pi-code-gui.refreshPackages",
          "when": "view == pi-code-gui.packages",
          "group": "navigation"
        },
        {
          "command": "pi-code-gui.updateAllPackages",
          "when": "view == pi-code-gui.packages",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js && node esbuild.webview.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:webview": "node esbuild.webview.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production && node esbuild.webview.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "check-types": "tsc --noEmit && tsc --noEmit -p tsconfig.webview.json",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:smoke": "npx tsx src/test/smoke.test.ts",
    "vsix": "pnpm run package && npx @vscode/vsce package --no-dependencies",
    "wiki:lint": "npx tsx agent-wiki/scripts/wiki-lint.ts",
    "wiki:lint:full": "npx tsx agent-wiki/scripts/wiki-lint.ts --full",
    "publish": "vsce publish --no-yarn --skip-duplicate",
    "un-publish": "vsce unpublish",
    "vsix:openvsx": "pnpm run package && pnpm exec ovsx publish"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@vscode/vsce-sign",
      "keytar"
    ]
  },
  "devDependencies": {
    "@types/node": "~22.19.19",
    "@types/vscode": "^1.118.0",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.27.7",
    "eslint": "^9.39.4",
    "npm-run-all": "^4.1.5",
    "ovsx": "^0.10.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.3",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@types/mocha": "^10.0.10",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "morphdom": "^2.7.8"
  }
}
